layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    // ☍ ♅ ♆ ꐠꆛ

    tab name="♅ main" cwd="~/" {
        floating_panes {
            pane cwd="~/" {
                x "70%"
                y "5%"
                width "30%"
                height "40%"
                plugin location="zj-hooker"
            }
        }
        pane
    }

    tab name="♆ rusting" cwd="~/Documents/bav"  {
        pane
    }

    tab name="☍ dev" cwd="~/Documents/bav" focus=true {
        pane
    }

    tab name="ꆛconfig"  split_direction="vertical" {
        pane cwd="~/Documents/dotfiles"
        pane cwd="~/.config/nvim"
    }

    tab name="btop"  {
        pane command="btop"
    }
}
